# 사용할 LLM provider: gemini | openai
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=openai

# Gemini
GOOGLE_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# 고객 DB (Oracle, docker-compose.yml)
DB_HOST=localhost
DB_PORT=1521
DB_SERVICE=XEPDB1
DB_USER=bank_user
DB_PASSWORD=
ORACLE_SYS_PASSWORD=

# LLM 응답 캐시 (backend/data/llm_cache.sqlite3). false면 끔
LLM_CACHE_ENABLED=true
